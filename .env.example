# Salin ke server/.env — jangan commit secret asli.
NODE_ENV=development
PORT=8787
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sawala
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
ALLOWED_ORIGINS=http://localhost:5173
# Google OAuth (Google Identity Services). Isi dengan Client ID milik Anda.
GOOGLE_CLIENT_ID=
# Login dev tanpa Google. WAJIB false di staging/production.
AUTH_DEV_LOGIN=true
# LLM: gemini | mock. Mock hanya untuk development/test (data sintetis).
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
EMBEDDING_PROVIDER=mock
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
# Batas
MAX_MESSAGE_CHARS=4000
MAX_OUTPUT_TOKENS=700
DAILY_MESSAGE_LIMIT=200
# Info bantuan krisis: HARUS diisi dari sumber resmi yang sudah diverifikasi sebelum rilis.
CRISIS_RESOURCES_TEXT=
# Feature flags (ditegakkan di backend)
FEATURE_LONG_TERM_MEMORY=true
FEATURE_MOOD_THEMES=true
FEATURE_PROACTIVE_GREETING=true
FEATURE_VOICE_CALLS=true
FEATURE_DATA_EXPORT=true

# Suara (Fase 3): FEATURE_VOICE_CALLS=true di atas. Jika REALTIME_PROVIDER=none, panggilan memakai mode browser (Chrome/Edge).
# Uji dulu di staging dengan data sintetis (lihat docs/RELEASE_GATES.md Gate 3). Bisa dimatikan seketika dari /admin (kill switch).
# Anggaran dan biaya (0 = nonaktif). Harga TIDAK ditanam di kode: isi dari harga provider yang sudah diverifikasi.
DAILY_TOKEN_BUDGET_GLOBAL=0
DAILY_TOKEN_BUDGET_PER_USER=0
COST_PER_1M_INPUT_TOKENS=0
COST_PER_1M_OUTPUT_TOKENS=0
COST_CURRENCY=USD
# Email operator (dipisah koma) yang boleh membuka GET /api/admin/usage
ADMIN_EMAILS=
# Panggilan suara
CALL_MAX_MINUTES=30
# Hanya untuk uji beban atau E2E: skala batas rate limit (1 = normal)
RATE_LIMIT_SCALE=1

# Alert operasional: webhook JSON (Slack/Discord/dll). Payload tanpa isi percakapan. Wajib https:// di staging/production.
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_MINUTES=60
ERROR_RATE_ALERT_THRESHOLD=0.2

# ===== Provider AI (pilih per kemampuan; lihat docs/PROVIDERS.md) =====
# LLM_PROVIDER (di atas): gemini | openai | anthropic | mock
# EMBEDDING_PROVIDER (di atas): gemini | openai | mock   (anthropic tidak punya embedding)
# Isi nama model dari dokumentasi vendor; tidak ditanam di kode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_STT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
STT_PROVIDER=none
TTS_PROVIDER=none

# ===== Suara realtime ("AI speak") =====
# none | gemini | openai (native speech-to-speech) | cascade (STT + LLM + TTS, vendor bebas) | mock (hanya dev)
REALTIME_PROVIDER=none
GEMINI_REALTIME_MODEL=
GEMINI_REALTIME_VOICE=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_REALTIME_TRANSCRIBE_MODEL=
# Penahanan audio balasan model native sampai transkrip lolos safety gate (ms)
VOICE_SAFETY_HOLD_MS=600

# ===== Retensi dan ketahanan =====
# Hapus otomatis percakapan tanpa aktivitas lebih dari N hari (0 = simpan sampai pengguna menghapus). Memori diatur terpisah oleh pengguna.
CHAT_RETENTION_DAYS=0
# Batas waktu satu panggilan ke model bahasa (ms)
LLM_TIMEOUT_MS=45000
