# Staging: meniru production (HTTPS, tanpa dev login, provider nyata) tetapi dengan database dan kredensial TERPISAH.
# Jangan menyalin data produksi ke staging. Pakai akun uji dan data sintetis.
NODE_ENV=staging
PORT=8788
MONGODB_URI=mongodb+srv://USER_STAGING:...@cluster-staging.example.mongodb.net
MONGODB_DB=sawala_staging
SESSION_SECRET=ganti-dengan-rahasia-berbeda-dari-production
ALLOWED_ORIGINS=https://staging.sawala.contoh.id
GOOGLE_CLIENT_ID=client-id-khusus-staging
AUTH_DEV_LOGIN=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=kunci-khusus-staging-dengan-kuota-kecil
GEMINI_MODEL=
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
CRISIS_RESOURCES_TEXT=
FEATURE_LONG_TERM_MEMORY=true
FEATURE_MOOD_THEMES=true
FEATURE_PROACTIVE_GREETING=true
FEATURE_DATA_EXPORT=true
FEATURE_VOICE_CALLS=true
DAILY_TOKEN_BUDGET_GLOBAL=200000
ADMIN_EMAILS=
