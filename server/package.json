{
  "name": "server",
  "private": true,
  "type": "module",
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "node_modules/.cache/mongodb-memory-server",
      "version": "7.0.24"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memdb": "tsx scripts/dev-memdb.ts",
    "eval": "tsx eval/run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:vector-index": "tsx scripts/create-vector-index.ts",
    "db:reembed": "tsx scripts/reembed.ts",
    "eval:safety": "tsx scripts/safety-report.ts",
    "voice:smoke": "tsx scripts/voice-smoke.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
